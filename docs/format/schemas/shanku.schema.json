{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanku.app/format/2/shanku.schema.json",
  "title": "Shanku project manifest (shanku.json)",
  "type": "object",
  "required": ["format", "schema", "app", "name", "model"],
  "properties": {
    "format": { "const": "shanku-project" },
    "schema": { "type": "integer", "minimum": 1 },
    "app": { "type": "string", "description": "The Shanku version that wrote it (semver)." },
    "name": { "type": "string", "minLength": 1 },
    "units": { "type": "object", "properties": { "length": { "enum": ["mm", "m"] } } },
    "model": {
      "type": "object",
      "required": ["path", "fileName"],
      "properties": { "path": { "type": "string", "pattern": "^model/[^/]+$" }, "fileName": { "type": "string" } }
    }
  }
}
